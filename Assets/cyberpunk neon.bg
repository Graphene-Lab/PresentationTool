<!-- Cyberpunk Neon animated background: neon rain over a glowing skyline -->
<style>
    .bg-cyber {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
        background: linear-gradient(180deg, #05060f 0%, #0d1030 55%, #1a1040 100%);
    }
    .bg-cyber canvas { display: block; width: 100%; height: 100%; }
    .bg-cyber::after {
        content: "";
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(0deg, rgba(255, 255, 255, .03) 0 1px, transparent 1px 4px);
    }
</style>
<script>
    (function () {
        'use strict';
        document.addEventListener('DOMContentLoaded', function () {
            var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
            var layer = document.createElement('div');
            layer.className = 'bg-cyber';
            var cv = document.createElement('canvas');
            layer.appendChild(cv);
            document.body.appendChild(layer);
            var ctx = cv.getContext('2d');
            var W = 0, H = 0, drops = [], win = [], t = 0, fc = 0;
            var sky = document.createElement('canvas');
            var sctx = sky.getContext('2d');

            function buildSky() {
                sky.width = Math.max(1, Math.round(W));
                sky.height = Math.max(1, Math.round(H));
                sctx.clearRect(0, 0, W, H);
                sctx.fillStyle = '#070812';
                sctx.fillRect(0, H * .72, W, H * .28);
                win = [];
                var x = 0;
                while (x < W) {
                    var bw = 60 + Math.random() * 110;
                    var bh = H * .06 + Math.random() * H * .16;
                    var by = H - bh;
                    sctx.fillStyle = '#0a0c1c';
                    sctx.fillRect(x, by, bw, bh);
                    if (Math.random() < .4) sctx.fillRect(x + bw * .45, by - 14, 3, 14);
                    for (var wx = x + 5; wx < x + bw - 8; wx += 9)
                        for (var wy = by + 6; wy < H - 8; wy += 11)
                            if (Math.random() < .22) {
                                var col = Math.random() < .5 ? 'rgba(0,229,255,.85)' : 'rgba(255,77,170,.75)';
                                win.push({ x: wx, y: wy, on: Math.random() < .5, col: col });
                            }
                    x += bw + 4;
                }
            }

            function resize() {
                var dpr = Math.min(window.devicePixelRatio || 1, 2);
                W = window.innerWidth; H = window.innerHeight;
                cv.width = W * dpr; cv.height = H * dpr;
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                var n = Math.round(W * H / 3800);
                drops = [];
                for (var i = 0; i < n; i++) drops.push({
                    x: Math.random() * W, y: Math.random() * H,
                    len: 12 + Math.random() * 20, s: 8 + Math.random() * 9,
                    c: Math.random() < .5 ? '0,229,255' : '255,77,170'
                });
                buildSky();
            }

            function lightning() {
                if (Math.random() > .006) return;
                var x = W * (0.2 + Math.random() * 0.6), y = 0;
                ctx.strokeStyle = 'rgba(200,240,255,.35)';
                ctx.lineWidth = 7;
                ctx.beginPath();
                ctx.moveTo(x, y);
                while (y < H * .55) { y += 30 + Math.random() * 45; x += (Math.random() - .5) * 90; ctx.lineTo(x, y); }
                ctx.stroke();
                ctx.strokeStyle = 'rgba(235,250,255,.95)';
                ctx.lineWidth = 2.2;
                ctx.beginPath();
                ctx.moveTo(x, y);
                while (y > 0) { y -= 30 + Math.random() * 45; x += (Math.random() - .5) * 90; ctx.lineTo(x, y); }
                ctx.stroke();
            }

            function frame() {
                t += reduced ? 0 : .016;
                fc++;
                ctx.clearRect(0, 0, W, H);
                // glow orbs
                ctx.globalCompositeOperation = 'lighter';
                for (var o = 0; o < 3; o++) {
                    var ox = W * (0.2 + 0.3 * o) + Math.sin(t * .7 + o * 2) * 60;
                    var oy = H * (0.25 + o * 0.12) + Math.cos(t * .9 + o) * 40;
                    var og = ctx.createRadialGradient(ox, oy, 0, ox, oy, 130);
                    og.addColorStop(0, o % 2 ? 'rgba(255,77,170,.28)' : 'rgba(0,229,255,.28)');
                    og.addColorStop(1, 'rgba(0,0,0,0)');
                    ctx.fillStyle = og;
                    ctx.beginPath(); ctx.arc(ox, oy, 130, 0, 6.283); ctx.fill();
                }
                ctx.globalCompositeOperation = 'source-over';
                // skyline
                ctx.drawImage(sky, 0, 0, W, H);
                // flickering windows
                if (fc % 5 === 0)
                    for (var w = 0; w < win.length; w++)
                        if (Math.random() < .03) win[w].on = Math.random() < .5;
                for (var w2 = 0; w2 < win.length; w2++)
                    if (win[w2].on) { ctx.fillStyle = win[w2].col; ctx.fillRect(win[w2].x, win[w2].y, 3, 4); }
                // neon rain
                ctx.lineWidth = 1.6;
                for (var i = 0; i < drops.length; i++) {
                    var d = drops[i];
                    if (!reduced) {
                        d.y += d.s;
                        d.x -= d.s * .18;
                        if (d.y > H) { d.y = -20; d.x = Math.random() * W; }
                        if (d.x < -10) d.x = W + 10;
                    }
                    ctx.strokeStyle = 'rgba(' + d.c + ',.55)';
                    ctx.beginPath();
                    ctx.moveTo(d.x, d.y);
                    ctx.lineTo(d.x + d.len * .18, d.y - d.len);
                    ctx.stroke();
                }
                if (!reduced) lightning();
                requestAnimationFrame(frame);
            }
            window.addEventListener('resize', resize);
            resize();
            requestAnimationFrame(frame);
        });
    })();
</script>

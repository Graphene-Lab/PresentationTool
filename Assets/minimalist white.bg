<!-- Minimalist White animated background: breathing pastel haze -->
<style>
    .bg-minimal {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
        background: #fbfcfe;
    }
    body.dark .bg-minimal { background: #101418; }
    .bg-minimal canvas { display: block; width: 100%; height: 100%; }
    .bg-minimal::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at center, transparent 60%, rgba(30, 40, 70, .10) 100%);
    }
</style>
<script>
    (function () {
        'use strict';
        document.addEventListener('DOMContentLoaded', function () {
            var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
            var layer = document.createElement('div');
            layer.className = 'bg-minimal';
            var cv = document.createElement('canvas');
            layer.appendChild(cv);
            document.body.appendChild(layer);
            var ctx = cv.getContext('2d');
            var W = 0, H = 0, blobs = [], dots = [], t = 0;
            var dark = document.body.classList.contains('dark');

            function rgba(c, a) { return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')'; }

            function palette() {
                return dark
                    ? { blobs: [[90, 130, 200], [150, 190, 230], [200, 170, 230], [160, 200, 210]], dot: [220, 230, 245] }
                    : { blobs: [[190, 214, 246], [220, 235, 250], [246, 214, 236], [214, 238, 234]], dot: [120, 140, 175] };
            }

            function resize() {
                var dpr = Math.min(window.devicePixelRatio || 1, 2);
                W = window.innerWidth; H = window.innerHeight;
                cv.width = W * dpr; cv.height = H * dpr;
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                var n = Math.max(3, Math.round(W * H / 260000));
                blobs = [];
                for (var i = 0; i < n; i++) blobs.push({
                    x: Math.random() * W, y: Math.random() * H,
                    r: Math.min(W, H) * (0.22 + Math.random() * 0.3),
                    vx: (Math.random() - .5) * .22, vy: (Math.random() - .5) * .22,
                    c: i, ph: Math.random() * 6.283
                });
                var nd = Math.round(W * H / 24000);
                dots = [];
                for (var j = 0; j < nd; j++) dots.push({
                    x: Math.random() * W, y: Math.random() * H,
                    r: .4 + Math.random() * 1.4, s: .06 + Math.random() * .25,
                    ph: Math.random() * 6.283
                });
            }

            function frame() {
                t += reduced ? 0 : .004;
                var p = palette();
                ctx.clearRect(0, 0, W, H);
                ctx.globalCompositeOperation = 'lighter';
                for (var i = 0; i < blobs.length; i++) {
                    var b = blobs[i];
                    if (!reduced) { b.x += b.vx; b.y += b.vy; }
                    if (b.x < -b.r) b.x = W + b.r; if (b.x > W + b.r) b.x = -b.r;
                    if (b.y < -b.r) b.y = H + b.r; if (b.y > H + b.r) b.y = -b.r;
                    var r = b.r * (1 + Math.sin(t * 10 + b.ph) * .1);
                    var g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, r);
                    g.addColorStop(0, rgba(p.blobs[b.c % p.blobs.length], dark ? .22 : .35));
                    g.addColorStop(1, rgba(p.blobs[b.c % p.blobs.length], 0));
                    ctx.fillStyle = g;
                    ctx.beginPath(); ctx.arc(b.x, b.y, r, 0, 6.283); ctx.fill();
                }
                ctx.globalCompositeOperation = 'source-over';
                for (var j = 0; j < dots.length; j++) {
                    var d = dots[j];
                    if (!reduced) {
                        d.x += Math.sin(t * 3 + d.ph) * d.s * 2;
                        d.y += Math.cos(t * 2.4 + d.ph * 1.3) * d.s * 1.6;
                    }
                    ctx.fillStyle = rgba(p.dot, .18 + .2 * Math.abs(Math.sin(t * 2 + d.ph)));
                    ctx.beginPath(); ctx.arc(d.x, d.y, d.r, 0, 6.283); ctx.fill();
                }
                requestAnimationFrame(frame);
            }

            var mo = new MutationObserver(function () { dark = document.body.classList.contains('dark'); });
            mo.observe(document.body, { attributes: true, attributeFilter: ['class'] });
            window.addEventListener('resize', resize);
            resize();
            requestAnimationFrame(frame);
        });
    })();
</script>
